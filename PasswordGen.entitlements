<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        Entitlements for the Developer ID signature, which uses the hardened
        runtime (required for notarization).

        The app is not sandboxed, so the network entitlement below is
        declarative rather than load-bearing: an unsandboxed process may make
        outgoing connections regardless. It is recorded here because outgoing
        HTTPS is the only privilege the app actually exercises, and so the
        signature says so if the sandbox is ever turned on.
    -->

    <!-- Outgoing HTTPS: password fetches from grc.com, update checks against api.github.com -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Deliberately not requested: the app reads and writes no files, spawns no
         subprocesses, and needs no JIT or unsigned executable memory. -->
</dict>
</plist>
